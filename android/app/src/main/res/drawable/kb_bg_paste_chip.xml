<?xml version="1.0" encoding="utf-8"?>
<!-- Paste chip: 36dp visible inside a 48dp touch box, 18dp corners, key fill, 1dp outline. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="6dp"
    android:insetBottom="6dp">
    <ripple android:color="@color/kb_ripple">
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="18dp" />
                <solid android:color="@color/kb_key" />
                <stroke android:width="1dp" android:color="@color/kb_outline" />
            </shape>
        </item>
    </ripple>
</inset>
