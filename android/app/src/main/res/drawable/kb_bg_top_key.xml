<?xml version="1.0" encoding="utf-8"?>
<!-- 40dp visible key inside the 48dp touch box (4dp inset on every side).
     The shape has to sit in an <item>: a bare <shape> directly under <ripple>
     is not drawn. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="4dp"
    android:insetRight="4dp"
    android:insetBottom="4dp">
    <ripple android:color="@color/kb_ripple">
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="@color/kb_key_alt" />
            </shape>
        </item>
    </ripple>
</inset>
