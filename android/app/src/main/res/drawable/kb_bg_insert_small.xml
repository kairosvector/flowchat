<?xml version="1.0" encoding="utf-8"?>
<!-- 28dp circle inside a 48x48 touch area: 10dp above/below, 14dp before,
     6dp after (the chip's end padding). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/kb_ripple">
    <item
        android:id="@android:id/mask"
        android:top="10dp"
        android:bottom="10dp"
        android:start="14dp"
        android:end="6dp">
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item
        android:top="10dp"
        android:bottom="10dp"
        android:start="14dp"
        android:end="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/kb_primary_container" />
        </shape>
    </item>
</ripple>
