<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:width="26dp" android:height="16dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/kb_on_surface_variant" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:width="8dp" android:height="8dp" android:gravity="start|center_vertical" android:start="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/kb_on_surface_variant" />
        </shape>
    </item>
</layer-list>
