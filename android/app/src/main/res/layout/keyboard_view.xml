<!-- Fork6 round 11 (SPEC_r8, layout D): fixed 280dp panel:
     top row (48): tabs | status slot | tone key | backspace,
     middle area (160): voice group / history list / result card,
     bottom action row (52).
     What is visible is decided in one place, WhisperKeyboard.render(),
     from the UiState and the selected tab. -->
<!-- The input-method framework ignores the root view's own layout_height
     (it re-adds the view as wrap_content), so the fixed 280dp lives on the
     inner LinearLayout, whose params survive inflation. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_background"
    android:clipChildren="false"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Top row, 48dp: voice | emoji (R3, invisible) | history | status | tone | backspace -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/tab_voice"
            style="@style/KbTopKey"
            android:background="@drawable/kb_bg_tab"
            android:contentDescription="@string/kb_tab_voice"
            android:src="@drawable/kb_ic_mic"
            app:tint="@color/kb_color_tab" />

        <ImageButton
            android:id="@+id/tab_emoji"
            style="@style/KbTopKey"
            android:background="@drawable/kb_bg_tab"
            android:contentDescription="@string/kb_tab_emoji"
            android:src="@drawable/kb_ic_emoji"
            android:visibility="invisible"
            app:tint="@color/kb_color_tab" />

        <ImageButton
            android:id="@+id/tab_clip"
            style="@style/KbTopKey"
            android:background="@drawable/kb_bg_tab"
            android:contentDescription="@string/kb_tab_clip"
            android:src="@drawable/kb_ic_paste"
            app:tint="@color/kb_color_tab" />

        <FrameLayout
            android:id="@+id/status_slot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/kb_on_surface_variant"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/btn_tone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/kb_bg_top_ai"
            android:clickable="true"
            android:contentDescription="@string/kb_polish"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tone_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/kb_ic_sparkle_state"
                app:tint="@color/kb_color_top_ai" />

            <TextView
                android:id="@+id/tone_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:singleLine="true"
                android:text="@string/kb_tone_pro_short"
                android:textColor="@color/kb_color_top_ai"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.example.whispertoinput.keyboard.BackspaceButton
            android:id="@+id/btn_backspace"
            style="@style/KbTopKey"
            android:contentDescription="@string/kb_backspace"
            android:src="@drawable/kb_ic_backspace"
            app:tint="@color/kb_on_surface" />
    </LinearLayout>

    <!-- Middle area (160dp): the voice group, the history list or the result card. -->
    <FrameLayout
        android:id="@+id/middle_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/group_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mic_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/left_slot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <FrameLayout
                        android:id="@+id/key_language_col"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageButton
                            android:id="@+id/btn_language"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/kb_bg_secondary_key"
                            android:contentDescription="@string/kb_language"
                            android:padding="13dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/kb_ic_translate"
                            android:tint="@color/kb_on_surface" />

                        <TextView
                            android:id="@+id/label_language"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="96dp"
                            android:gravity="center_horizontal"
                            android:text="@string/kb_lang_auto"
                            android:textColor="@color/kb_on_surface_variant"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <com.example.whispertoinput.keyboard.WaveformView
                        android:id="@+id/wave_left"
                        android:layout_width="84dp"
                        android:layout_height="56dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/mic_frame"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <com.example.whispertoinput.keyboard.PulseRingView
                        android:id="@+id/pulse_rings"
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <com.example.whispertoinput.keyboard.SpinnerRingView
                        android:id="@+id/spinner_ring"
                        android:layout_width="124dp"
                        android:layout_height="124dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btn_mic"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/kb_bg_mic_idle"
                        android:contentDescription="@string/start_speech_to_text"
                        android:elevation="3dp"
                        android:padding="26dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/kb_ic_mic"
                        android:tint="@color/kb_on_primary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/right_slot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <FrameLayout
                        android:id="@+id/key_settings_col"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageButton
                            android:id="@+id/btn_settings"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/kb_bg_secondary_key"
                            android:contentDescription="@string/kb_settings"
                            android:padding="13dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/kb_ic_settings"
                            android:tint="@color/kb_on_surface" />

                        <TextView
                            android:id="@+id/label_settings"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_marginEnd="12dp"
                            android:layout_marginTop="96dp"
                            android:gravity="center_horizontal"
                            android:text="@string/kb_settings"
                            android:textColor="@color/kb_on_surface_variant"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <com.example.whispertoinput.keyboard.WaveformView
                        android:id="@+id/wave_right"
                        android:layout_width="84dp"
                        android:layout_height="56dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="4dp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Hint line (idle / recording), step chips (processing)
                 and the retry chip share this 24dp row. -->
            <LinearLayout
                android:id="@+id/hint_row"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/label_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kb_hint_idle"
                    android:textColor="@color/kb_on_surface_variant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/steps_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/step_record"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/kb_bg_step_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/kb_step_record_done"
                        android:textColor="@color/kb_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/step_transcribe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/kb_bg_step_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/kb_step_transcribing"
                        android:textColor="@color/kb_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/step_polish"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/kb_bg_step_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/kb_step_polish"
                        android:textColor="@color/kb_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/kb_bg_retry_chip"
                    android:clickable="true"
                    android:contentDescription="@string/kb_retry"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="1dp"
                    android:text="@string/kb_retry"
                    android:textColor="@color/kb_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- History tab (card area 396x156): title row 32 + scrolling list. -->
        <LinearLayout
            android:id="@+id/group_clip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/seg_history"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/kb_bg_step_chip_active"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/kb_seg_history"
                    android:textColor="@color/kb_on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/clip_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/clip_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/clip_empty"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center"
                        android:text="@string/kb_history_empty"
                        android:textColor="@color/kb_on_surface_variant"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Result card (396x156): polished text (2 lines, scrolls) above the
             original (2 lines), then the actions. Not inserted yet = pending. -->
        <LinearLayout
            android:id="@+id/group_result"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@drawable/kb_bg_card"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/result_scroll"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Polishing failed: say so, with a retry that only
                         re-runs the polish (no new recording). -->
                    <LinearLayout
                        android:id="@+id/row_notice"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/text_notice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kb_polish_failed"
                            android:textColor="@color/kb_recording"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btn_notice_action"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/kb_polish_retry"
                            android:textColor="@color/kb_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_ai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/kb_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </ScrollView>

            <TextView
                android:id="@+id/text_raw"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/kb_on_surface_variant"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/row_actions"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/action_insert"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/kb_bg_action_primary_touch"
                    android:clickable="true"
                    android:contentDescription="@string/kb_action_insert"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="78dp"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/action_insert_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kb_ic_insert"
                        android:tint="@color/kb_on_primary" />

                    <TextView
                        android:id="@+id/action_insert_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/kb_action_insert"
                        android:textColor="@color/kb_on_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/action_repolish"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/kb_bg_action_outline_touch"
                    android:clickable="true"
                    android:contentDescription="@string/kb_action_repolish"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="102dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kb_ic_refresh"
                        android:tint="@color/kb_on_surface" />

                    <TextView
                        android:id="@+id/action_repolish_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/kb_action_repolish"
                        android:textColor="@color/kb_on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 36dp visible icon buttons with a 48dp touch box (6dp inset each side). -->
                <LinearLayout
                    android:id="@+id/action_copy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/kb_bg_action_icon_touch"
                    android:clickable="true"
                    android:contentDescription="@string/kb_action_copy"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kb_ic_copy"
                        android:tint="@color/kb_on_surface" />
                </LinearLayout>

                <!-- Discard (not inserted yet) and undo (inserted) are one view:
                     only the icon, the description and the action change. -->
                <LinearLayout
                    android:id="@+id/action_undo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-6dp"
                    android:background="@drawable/kb_bg_action_icon_touch"
                    android:clickable="true"
                    android:contentDescription="@string/kb_result_discard"
                    android:focusable="true"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/action_undo_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/kb_ic_close"
                        android:tint="@color/kb_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom action row, 52dp:
         left key (72dp) | space (0dp weight 1) | enter (72dp) -->
    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_left_action"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:background="@drawable/kb_bg_key_alt"
            android:contentDescription="@string/btn_previous_ime_hint"
            android:paddingStart="25dp"
            android:paddingTop="15dp"
            android:paddingEnd="25dp"
            android:paddingBottom="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/kb_ic_keyboard"
            app:tint="@color/kb_on_surface_variant" />

        <LinearLayout
            android:id="@+id/btn_space_bar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/kb_bg_key"
            android:clickable="true"
            android:contentDescription="@string/desc_space_bar"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/kb_ic_space"
                app:tint="@color/kb_on_surface_variant" />

            <TextView
                android:id="@+id/label_space"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/kb_space"
                android:textColor="@color/kb_on_surface_variant"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_enter"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/kb_bg_key_container"
            android:contentDescription="@string/start_transcribing"
            android:paddingStart="25dp"
            android:paddingTop="15dp"
            android:paddingEnd="25dp"
            android:paddingBottom="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/kb_ic_enter"
            app:tint="@color/kb_on_primary_container" />
    </LinearLayout>
</LinearLayout>

    <!-- Overlays (SPEC_r8 §2.5): drawn over the middle and bottom rows; the top
         row stays visible. Not a PopupWindow: an IME window has no usable token. -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="224dp"
        android:layout_marginTop="56dp"
        android:background="@color/kb_scrim"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Tone menu: 208dp wide, right edge on x = 404, rows of 44dp added by code. -->
    <ScrollView
        android:id="@+id/tone_menu"
        android:layout_width="208dp"
        android:layout_height="144dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/kb_bg_tone_menu"
        android:clipToOutline="true"
        android:elevation="6dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tone_menu_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </ScrollView>

    <!-- Prompt viewer: 396 x 214 card at (8, 58). -->
    <LinearLayout
        android:id="@+id/prompt_sheet"
        android:layout_width="match_parent"
        android:layout_height="214dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/kb_bg_card"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/prompt_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kb_prompt_back"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/kb_ic_arrow_back"
                app:tint="@color/kb_on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:singleLine="true"
                android:text="@string/kb_prompt_title"
                android:textColor="@color/kb_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/prompt_edit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="@string/kb_prompt_edit"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/kb_ic_edit"
                    app:tint="@color/kb_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/kb_prompt_edit"
                    android:textColor="@color/kb_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/prompt_chips"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/prompt_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/prompt_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/kb_on_surface"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
